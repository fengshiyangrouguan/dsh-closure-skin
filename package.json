{
  "name": "dsh-closure-skin",
  "version": "0.1.1",
  "description": "可露希尔配套皮肤：街机像素风格，罗德岛天才工程师特供工作站",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "locale",
    "lib",
    "icon.png",
    "cordis.patch.yml",
    "LICENSE",
    "LICENSE-FONT",
    "FONT-NOTICE.md",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-skin",
    "client-theme",
    "pixel-art",
    "crt",
    "arknights",
    "closure"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengshiyangrouguan/dsh-closure-skin.git"
  },
  "homepage": "https://github.com/fengshiyangrouguan/dsh-closure-skin#readme",
  "bugs": {
    "url": "https://github.com/fengshiyangrouguan/dsh-closure-skin/issues"
  },
  "license": "MIT",
  "author": "FSYRG"
}
